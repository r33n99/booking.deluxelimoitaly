{
  "name": "dli_project",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "stage": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "tests": "vitest run",
    "tests:watch": "vitest",
    "tests:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e headed": "npx playwright test --headed",
    "test:e2e ui": "npx playwright test --ui",
    "test:e2e:with-server": "start-server-and-test 'npm run dev' http://localhost:5173 'npm run test:e2e'"
  },
  "dependencies": {
    "@fawmi/vue-google-maps": "^0.9.79",
    "@gtm-support/vue-gtm": "^2.2.0",
    "@sentry/browser": "^7.61.1",
    "@sentry/vue": "^7.61.1",
    "@stripe/stripe-js": "^7.8.0",
    "@takuma-ru/vue-swipe-modal": "^4.0.7",
    "@vuepic/vue-datepicker": "^11.0.2",
    "@vueuse/core": "^10.11.1",
    "centrifuge": "^5.0.1",
    "collect.js": "^4.36.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "flowbite": "^2.5.2",
    "flowbite-vue": "*",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.11.16",
    "load-google-maps-api": "^2.0.2",
    "pinia": "^2.1.4",
    "point-in-polygon": "^1.1.0",
    "swiper": "^9.3.2",
    "typescript": "^5.9.3",
    "update-input-width": "^1.4.2",
    "vee-validate": "^4.11.1",
    "vue": "^3.3.4",
    "vue-google-autocomplete": "^1.1.4",
    "vue-router": "^4.2.4",
    "vue-tel-input": "^8.3.1",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@pinia/testing": "^0.1.7",
    "@playwright/test": "^1.48.2",
    "@rushstack/eslint-patch": "^1.3.2",
    "@sentry/vite-plugin": "^2.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.13.1",
    "@types/stripe-v3": "^3.1.33",
    "@types/swiper": "^5.4.3",
    "@types/vue-tel-input": "^2.1.7",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.14",
    "axios": "^1.4.0",
    "c8": "^10.1.3",
    "dompurify": "^3.3.0",
    "eslint": "^8.45.0",
    "eslint-plugin-vue": "^9.15.1",
    "happy-dom": "^18.0.1",
    "husky": "^9.0.11",
    "msw": "^2.10.4",
    "postcss": "^8.4.27",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "sass": "^1.89.2",
    "start-server-and-test": "^2.0.9",
    "tailwindcss": "^3.4.3",
    "vite": "^4.4.6",
    "vite-plugin-checker": "^0.10.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^0.16.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.2"
  }
}
